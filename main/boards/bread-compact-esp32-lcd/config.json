{
    "type": "bread-compact-esp32-lcd",
    "target": "esp32",
    "builds": [
        {
            "name": "bread-compact-esp32-lcd",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240_7PIN=y"
            ]
        },
        {
            "name": "bread-compact-esp32-lcd-st7735-128x160",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7735_128X160=y"
            ]
        },
        {
            "name": "bread-compact-esp32-lcd-st7735-128x128",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7735_128X128=y"
            ]
        }
    ]
}
